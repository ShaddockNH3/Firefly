---
import { Icon } from "astro-icon/components";
import WowsShips from "@/components/pages/wows/WowsShips.svelte";
import { siteConfig } from "@/config";
import meta from "@/data/wows/meta.json";
import profile from "@/data/wows/profile.json";
import ships from "@/data/wows/ships.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.wows) {
	return Astro.redirect("/404/");
}

const p = profile.pvp;
const overall = profile.overall;

/** JSON 里的时间戳是秒，统一按 UTC 切成日期 */
const day = (sec: number) => new Date(sec * 1000).toISOString().slice(0, 10);
const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
const num = (v: number) => v.toLocaleString("en-US");

const kpis = [
	{
		icon: "material-symbols:swords",
		label: "场次",
		value: num(p.battles),
		unit: "",
	},
	{
		icon: "material-symbols:percent",
		label: "胜率",
		value: pct(p.winrate),
		unit: "",
	},
	{
		icon: "material-symbols:destruction",
		label: "场均伤害",
		value: num(p.avgDamage),
		unit: "",
	},
	{
		icon: "material-symbols:local-fire-department",
		label: "最高伤害",
		value: num(p.maxDamage),
		unit: "",
	},
	// 卡片窄，PR 的分档文字塞不进一行，只留数字
	{
		icon: "material-symbols:military-tech",
		label: "PR",
		value: overall ? num(overall.pr) : "—",
		unit: "",
		hi: true,
	},
];
---

<MainGridLayout title="舰长档案" description={`${profile.nickname} 的战舰世界战绩，${profile.realmLabel}`}>
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<!-- 档案头 -->
		<div class="flex items-center gap-4 sm:gap-6 flex-wrap">
			<div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full shrink-0 flex items-center justify-center bg-(--btn-regular-bg) text-(--primary)">
				<Icon name="material-symbols:anchor" class="text-[2rem]" />
			</div>
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-2 flex-wrap">
					<span class="text-xl font-bold text-(--deep-text)">{profile.nickname}</span>
					<span class="text-[0.7rem] font-semibold px-2 py-0.5 rounded-full bg-(--primary)/12 text-(--primary)">
						{profile.realmLabel}
					</span>
				</div>
				<div class="flex items-center gap-3 mt-1 text-[0.78rem] text-(--content-meta) flex-wrap">
					<span class="inline-flex items-center gap-1">
						<Icon name="material-symbols:calendar-month" class="text-[0.95rem] opacity-70" />
						{day(profile.createdAt)} 入坑
					</span>
					<span class="inline-flex items-center gap-1">
						<Icon name="material-symbols:workspace-premium" class="text-[0.95rem] opacity-70" />
						舰长等级 {profile.levelingTier}
					</span>
					<span class="inline-flex items-center gap-1">
						<Icon name="material-symbols:sailing" class="text-[0.95rem] opacity-70" />
						{ships.length} 艘出战
					</span>
				</div>
			</div>
			<span class="text-[0.7rem] text-(--content-meta) inline-flex items-center gap-1 ml-auto">
				<Icon name="material-symbols:schedule" class="text-[0.9rem]" />
				更新于 {meta.generatedAt.slice(0, 10)}
			</span>
		</div>

		<!-- 指标 -->
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-5">
			{kpis.map((k) => (
				<div class="rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-3">
					<div class="flex items-center gap-1.5 text-[0.72rem] text-(--content-meta)">
						<Icon name={k.icon} class="text-[0.95rem] opacity-65" />
						{k.label}
					</div>
					<div class="mt-1 flex items-baseline gap-1">
						<span class:list={["text-[1.32rem] font-bold tabular-nums leading-tight", k.hi ? "text-(--primary)" : "text-(--deep-text)"]}>
							{k.value}
						</span>
						{k.unit && <span class="text-[0.7rem] text-(--content-meta)">{k.unit}</span>}
					</div>
				</div>
			))}
		</div>

		<WowsShips client:load {ships} />
	</div>
</MainGridLayout>
