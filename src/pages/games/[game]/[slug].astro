---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import { siteConfig } from "@/config";
import { gameListHref, gameMeta, isGameKey } from "@/config/games";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/manga-detail.css";

export async function getStaticPaths() {
	if (!siteConfig.pages.games) return [];
	const entries = (await getCollection("games")).filter((e) => !e.data.draft);
	return entries.map((entry) => {
		const [game, ...rest] = entry.id.split("/");
		if (!isGameKey(game)) {
			throw new Error(
				`[games] ${entry.id} 所在目录 ${game} 没在 src/config/games.ts 里登记`,
			);
		}
		return {
			params: { game, slug: rest.join("/") },
			props: { entry, game },
		};
	});
}

const { entry, game } = Astro.props;
const d = entry.data;
const meta = gameMeta(game);
const hasBody = (entry.body ?? "").trim().length > 0;
const { Content } = await render(entry);

const rows = [
	{ k: "平台", v: d.platform || "—" },
	{ k: "年份", v: d.released || "—" },
	{ k: "难度", v: d.difficulty ? `${d.difficulty} / 5` : "" },
	{ k: "状态", v: d.status },
	{ k: "我的评分", v: d.score !== null ? `${d.score.toFixed(1)} / 10` : "" },
	{ k: "最近", v: d.updated },
].filter((r) => r.v);
---

<MainGridLayout
	title={`${d.title} · 单机游戏`}
	description={`${meta?.name ?? ""} ${d.title} 的版本记录`}
>
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<a href={gameListHref(game)} class="md-back">
			<Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
			单机游戏
		</a>

		<div class="md-head">
			<div class="md-cover">
				{
					d.cover ? (
						<img src={d.cover} alt={d.title} referrerpolicy="no-referrer" />
					) : (
						<div class="md-cover-t">{d.title}</div>
					)
				}
			</div>

			<div class="md-info">
				<h1 class="md-title">{d.title}</h1>
				{meta && <p class="md-alt">{meta.name}</p>}

				<div class="md-tags">
					<span class="md-tag">{d.kind}</span>
				</div>

				<div class="md-rows">
					{
						rows.map((r) => (
							<div class="md-row">
								<span class="md-k">{r.k}</span>
								<span class="md-v" data-status={r.k === "状态" ? r.v : undefined}>
									{r.v}
								</span>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>

	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7 mt-4">
		<div class="md-sec-t">
			这个版本改了什么
			{d.score !== null && <span class="md-sec-n">{d.score.toFixed(1)}</span>}
		</div>
		{
			hasBody ? (
				<Markdown class="md-review">
					<Content />
				</Markdown>
			) : (
				<p class="md-empty">还没写。</p>
			)
		}
	</div>
</MainGridLayout>
