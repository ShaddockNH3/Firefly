---
import MangaTabs from "@/components/pages/manga/MangaTabs.astro";
import { siteConfig } from "@/config";
import enc from "@/data/manga/adult.enc.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.manga) {
	return Astro.redirect("/404/");
}

// 这个文件里只有密文。明文由 scripts/export-manga.mjs 在本地生成后立刻加密，
// 全程不落盘、不进 git。未解锁时页面里既没有书名，也没有封面地址。
const payload = enc.data;
---

<MainGridLayout title="成人向" description="密码保护的漫画清单">
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<MangaTabs active="adult" />

		<div class="flex items-center gap-3 flex-wrap mb-4">
			<h2 class="text-lg font-bold text-(--deep-text) m-0">成人向</h2>
			<span class="ml-auto inline-flex items-center gap-1 text-[0.7rem] text-(--content-meta)">
				整页加密 · 密码解锁后显示
			</span>
		</div>

		<!-- 未解锁 -->
		<div id="manga-gate" class="mx-auto max-w-115 py-10 text-center">
			<div
				class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-(--primary)/10 text-(--primary)"
			>
				<svg
					viewBox="0 0 24 24"
					width="26"
					height="26"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="3" y="11" width="18" height="11" rx="2"></rect>
					<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
				</svg>
			</div>
			<h3 class="m-0 mb-2 text-base font-bold text-(--deep-text)">本页受密码保护</h3>
			<p class="m-0 mb-5 text-[0.78rem] leading-relaxed text-(--content-meta)">
				清单在构建时已加密，没有密码时页面里只有一段密文。<br />未满 18 岁请勿继续。
			</p>
			<form id="manga-form" class="flex flex-col gap-2">
				<input
					id="manga-pw"
					type="password"
					autocomplete="off"
					placeholder="输入密码"
					class="w-full rounded-lg border border-(--line-divider) bg-black/3 px-3 py-2 text-sm text-(--deep-text) outline-hidden transition focus:border-(--primary) dark:bg-white/8"
				/>
				<button
					type="submit"
					class="w-full rounded-lg bg-(--primary) py-2 text-sm font-semibold text-white transition hover:opacity-90 active:scale-[0.99]"
				>
					解锁
				</button>
			</form>
			<p id="manga-error" class="m-0 mt-3 hidden text-[0.72rem] text-red-500 dark:text-red-400">
				密码不对
			</p>
			<p class="m-0 mt-4 text-[0.7rem] text-(--content-meta) opacity-70">
				密码只存在本地 sessionStorage，关掉标签页就没了
			</p>
		</div>

		<!-- 已解锁 -->
		<div id="manga-main" class="hidden">
			<!-- 列表视图 -->
			<div id="manga-list-view">
				<div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
					<b class="text-[0.84rem] text-(--deep-text)" id="manga-count"></b>
					<span class="text-[0.72rem] text-(--content-meta)" id="manga-hint"></span>
					<button
						id="manga-lock"
						class="ml-auto cursor-pointer border-0 bg-none p-0 text-[0.74rem] text-(--content-meta) hover:text-(--primary)"
					>
						上锁
					</button>
				</div>

				<!-- 分类：就是 Venera 里的收藏夹 -->
				<div id="manga-cats" class="mb-4 flex flex-wrap gap-1.5"></div>

				<div id="manga-list" class="manga-grid"></div>
			</div>

			<!-- 详情视图：地址带 #id，刷新和分享都能回到这一条 -->
			<div id="manga-detail-view" class="hidden">
				<button id="manga-back" class="manga-back" type="button">
					<svg
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m15 18-6-6 6-6"></path>
					</svg>
					漫画
				</button>

				<div class="manga-dhead">
					<div class="manga-dcv" id="manga-dcv"></div>
					<div class="manga-dinfo">
						<h1 class="manga-dtitle" id="manga-dtitle"></h1>
						<div class="manga-dmeta" id="manga-dmeta"></div>
						<div class="manga-dtags" id="manga-dtags"></div>
					</div>
				</div>

				<div class="manga-dnote">
					<div class="manga-dsec">评价</div>
					<div class="manga-dnote-body" id="manga-dnote"></div>
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>

<style is:global>
	.manga-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
		gap: 18px 14px;
	}
	.manga-card {
		display: block;
		cursor: pointer;
		border: 0;
		background: none;
		padding: 0;
		text-align: left;
		font: inherit;
	}
	.manga-cv {
		position: relative;
		aspect-ratio: 3 / 4;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 20px 14px 16px;
		overflow: hidden;
		border: 1px solid hsl(var(--h) 30% 78% / 0.5);
		background: linear-gradient(
			162deg,
			hsl(var(--h) 48% 95%) 0%,
			hsl(var(--h) 46% 87%) 55%,
			hsl(var(--h) 42% 79%) 100%
		);
		transition:
			transform 0.18s,
			box-shadow 0.18s;
	}
	.manga-cv img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.manga-card:hover .manga-cv {
		transform: translateY(-2px);
		box-shadow: 0 10px 22px hsl(var(--h) 40% 40% / 0.16);
	}
	.manga-mid {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 0;
	}
	.manga-rule {
		width: 20px;
		height: 1px;
		background: hsl(var(--h) 34% 48% / 0.5);
		flex: none;
	}
	.manga-ttl {
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.6;
		letter-spacing: 0.08em;
		color: hsl(var(--h) 40% 24%);
		text-align: center;
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}
	.manga-foot {
		flex: none;
		font-size: 0.6rem;
		letter-spacing: 0.06em;
		color: hsl(var(--h) 26% 40% / 0.9);
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}
	.manga-sc {
		position: absolute;
		top: 6px;
		right: 6px;
		font-size: 0.64rem;
		font-weight: 800;
		padding: 1px 6px;
		border-radius: 6px;
		background: rgb(255 255 255 / 0.9);
		color: var(--primary);
	}
	.manga-nm {
		margin-top: 7px;
		font-size: 0.74rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--deep-text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* 分类 chip：样式跟站内筛选项一致 */
	.manga-chip {
		padding: 3px 11px;
		border-radius: 999px;
		border: 1px solid var(--line-divider);
		background: var(--card-bg);
		color: var(--content-meta);
		font-size: 0.72rem;
		font-family: inherit;
		cursor: pointer;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.manga-chip:hover {
		background: var(--btn-regular-bg);
	}
	.manga-chip[data-on="true"] {
		background: var(--primary);
		border-color: transparent;
		color: #fff;
	}
	.manga-chip em {
		font-style: normal;
		opacity: 0.65;
		margin-left: 3px;
	}

	/* 详情视图 */
	.manga-back {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		margin-bottom: 16px;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		font-size: 0.78rem;
		color: var(--content-meta);
		cursor: pointer;
	}
	.manga-back:hover {
		color: var(--primary);
	}
	.manga-dhead {
		display: flex;
		gap: 26px;
		align-items: flex-start;
	}
	.manga-dcv {
		width: 210px;
		flex: none;
		aspect-ratio: 3 / 4;
		border-radius: var(--radius-large);
		overflow: hidden;
		background: var(--btn-regular-bg);
		box-shadow: 0 4px 18px rgb(0 0 0 / 0.1);
	}
	.manga-dcv img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.manga-dinfo {
		flex: 1;
		min-width: 0;
		padding-top: 4px;
	}
	.manga-dtitle {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--deep-text);
		word-break: break-word;
	}
	.manga-dmeta {
		margin-top: 10px;
		font-size: 0.8rem;
		line-height: 1.8;
		color: var(--content-meta);
	}
	.manga-dtags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 10px;
	}
	.manga-dtags:empty {
		display: none;
	}
	.manga-dtag {
		font-size: 0.68rem;
		padding: 1px 7px;
		border-radius: 6px;
		background: var(--btn-regular-bg);
		color: var(--content-meta);
	}
	.manga-dnote {
		margin-top: 22px;
		padding-top: 16px;
		border-top: 1px solid var(--line-divider);
	}
	.manga-dsec {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--deep-text);
		margin-bottom: 10px;
	}
	.manga-dnote-body {
		font-size: 0.85rem;
		line-height: 1.9;
		color: color-mix(in oklch, var(--deep-text) 82%, transparent);
		white-space: pre-line;
	}
	.manga-dnote-empty {
		font-size: 0.82rem;
		color: var(--content-meta);
	}
	@media (max-width: 640px) {
		.manga-dhead {
			flex-direction: column;
			gap: 16px;
		}
		.manga-dcv {
			width: 150px;
		}
	}
</style>

<div id="manga-data" data-payload={payload} hidden></div>

<script is:inline>
	(function () {
		var ITERATIONS = 100000;
		var SALT_LEN = 16;
		var IV_LEN = 12;
		var TAG_LEN = 16;
		var CACHE_KEY = "pw:manga-adult";

		var payload = document.getElementById("manga-data").getAttribute("data-payload");

		var gate = document.getElementById("manga-gate");
		var main = document.getElementById("manga-main");
		var form = document.getElementById("manga-form");
		var input = document.getElementById("manga-pw");
		var err = document.getElementById("manga-error");
		var list = document.getElementById("manga-list");
		var cats = document.getElementById("manga-cats");
		var countEl = document.getElementById("manga-count");
		var hintEl = document.getElementById("manga-hint");
		var lockBtn = document.getElementById("manga-lock");

		var viewList = document.getElementById("manga-list-view");
		var viewDetail = document.getElementById("manga-detail-view");
		var dCv = document.getElementById("manga-dcv");
		var dTitle = document.getElementById("manga-dtitle");
		var dMeta = document.getElementById("manga-dmeta");
		var dTags = document.getElementById("manga-dtags");
		var dNote = document.getElementById("manga-dnote");

		document.getElementById("manga-back").addEventListener("click", function () {
			location.hash = "";
		});

		function b64ToBytes(b64) {
			var bin = atob(b64);
			var out = new Uint8Array(bin.length);
			for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
			return out;
		}

		async function decrypt(pwd) {
			var raw = b64ToBytes(payload);
			var salt = raw.slice(0, SALT_LEN);
			var iv = raw.slice(SALT_LEN, SALT_LEN + IV_LEN);
			var tag = raw.slice(SALT_LEN + IV_LEN, SALT_LEN + IV_LEN + TAG_LEN);
			var ct = raw.slice(SALT_LEN + IV_LEN + TAG_LEN);
			var combined = new Uint8Array(ct.length + TAG_LEN);
			combined.set(ct);
			combined.set(tag, ct.length);

			var enc = new TextEncoder();
			var km = await crypto.subtle.importKey("raw", enc.encode(pwd), "PBKDF2", false, [
				"deriveKey",
			]);
			var key = await crypto.subtle.deriveKey(
				{ name: "PBKDF2", salt: salt, iterations: ITERATIONS, hash: "SHA-256" },
				km,
				{ name: "AES-GCM", length: 256 },
				false,
				["decrypt"],
			);
			var plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: iv }, key, combined);
			return JSON.parse(new TextDecoder().decode(plain));
		}

		var HUES = [348, 275, 200, 24, 158, 315, 232, 42, 300, 190];
		function hueOf(s) {
			var h = 0;
			for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 9973;
			return HUES[h % HUES.length];
		}

		var ALL = "全部";
		var state = { items: [], cat: ALL };

		function card(item) {
			var wrap = document.createElement("button");
			wrap.type = "button";
			wrap.className = "manga-card";
			wrap.title = item.t;
			wrap.addEventListener("click", function () {
				location.hash = String(item.k);
			});

			var cv = document.createElement("div");
			cv.className = "manga-cv";
			cv.style.setProperty("--h", hueOf(item.t));

			if (item.c) {
				var img = document.createElement("img");
				img.loading = "lazy";
				img.referrerPolicy = "no-referrer";
				img.alt = "";
				img.src = item.c;
				// 图床挂了就退回排版封面，不留一个破图标
				img.addEventListener("error", function () {
					img.remove();
					buildFace(cv, item);
				});
				cv.appendChild(img);
			} else {
				buildFace(cv, item);
			}

			if (Number.isFinite(item.sc)) {
				var sc = document.createElement("span");
				sc.className = "manga-sc";
				sc.textContent = item.sc.toFixed(1);
				cv.appendChild(sc);
			}

			var nm = document.createElement("div");
			nm.className = "manga-nm";
			nm.textContent = item.t;

			wrap.append(cv, nm);
			return wrap;
		}

		// 没有封面时用书名排版占位
		function buildFace(cv, item) {
			var mid = document.createElement("div");
			mid.className = "manga-mid";
			var r1 = document.createElement("span");
			r1.className = "manga-rule";
			var ttl = document.createElement("span");
			ttl.className = "manga-ttl";
			ttl.textContent = item.t;
			var r2 = document.createElement("span");
			r2.className = "manga-rule";
			mid.append(r1, ttl, r2);

			var foot = document.createElement("span");
			foot.className = "manga-foot";
			foot.textContent = [item.s, item.y].filter(Boolean).join(" · ");

			cv.append(mid, foot);
		}

		function renderCats() {
			cats.replaceChildren();
			var counter = new Map();
			for (var i = 0; i < state.items.length; i++) {
				var f = state.items[i].f || "其他";
				counter.set(f, (counter.get(f) || 0) + 1);
			}
			var entries = [[ALL, state.items.length]].concat(
				[...counter.entries()].sort(function (a, b) {
					return b[1] - a[1];
				}),
			);

			entries.forEach(function (pair) {
				var b = document.createElement("button");
				b.type = "button";
				b.className = "manga-chip";
				b.dataset.on = String(state.cat === pair[0]);
				b.textContent = pair[0];
				var em = document.createElement("em");
				em.textContent = pair[1];
				b.appendChild(em);
				b.addEventListener("click", function () {
					state.cat = pair[0];
					renderCats();
					renderList();
				});
				cats.appendChild(b);
			});
		}

		function renderList() {
			list.replaceChildren();
			var frag = document.createDocumentFragment();
			var shown = 0;
			for (var i = 0; i < state.items.length; i++) {
				var it = state.items[i];
				if (state.cat !== ALL && (it.f || "其他") !== state.cat) continue;
				frag.append(card(it));
				shown += 1;
			}
			list.append(frag);
			countEl.textContent =
				state.cat === ALL ? "全部 " + shown + " 本" : state.cat + " " + shown + " 本";
			hintEl.textContent = "按 Venera 收藏夹分类";
		}

		// 详情：地址栏是 #<条目 id>，刷新或分享都能回到这一条
		function showDetail(id) {
			var item = null;
			for (var i = 0; i < state.items.length; i++) {
				if (String(state.items[i].k) === String(id)) {
					item = state.items[i];
					break;
				}
			}
			if (!item) {
				// id 不在清单里（书被删了或链接打错），退回列表
				location.hash = "";
				return;
			}

			dCv.replaceChildren();
			if (item.c) {
				var img = document.createElement("img");
				img.src = item.c;
				img.referrerPolicy = "no-referrer";
				img.alt = "";
				dCv.appendChild(img);
			}
			dTitle.textContent = item.t;

			var bits = [item.s, item.f, item.y].filter(Boolean);
			if (Number.isFinite(item.sc)) bits.push("评分 " + item.sc.toFixed(1));
			dMeta.textContent = bits.join(" · ");

			dTags.replaceChildren();
			var tg = item.tg || [];
			for (var j = 0; j < tg.length; j++) {
				var tag = document.createElement("span");
				tag.className = "manga-dtag";
				tag.textContent = tg[j];
				dTags.appendChild(tag);
			}

			dNote.replaceChildren();
			if (item.nt) {
				dNote.textContent = item.nt;
			} else {
				var empty = document.createElement("span");
				empty.className = "manga-dnote-empty";
				empty.textContent = "还没写评价。";
				dNote.appendChild(empty);
			}

			viewList.classList.add("hidden");
			viewDetail.classList.remove("hidden");
			window.scrollTo({ top: 0, behavior: "instant" });
		}

		function showList() {
			viewDetail.classList.add("hidden");
			viewList.classList.remove("hidden");
		}

		function route() {
			if (!state.items.length) return; // 还没解锁
			var id = location.hash.replace(/^#/, "");
			if (id) showDetail(id);
			else showList();
		}

		window.addEventListener("hashchange", route);

		function render(data) {
			state.items = data.items;
			state.cat = ALL;
			renderCats();
			renderList();
			gate.classList.add("hidden");
			main.classList.remove("hidden");
			route(); // 直接带 #id 打开时也进得去
		}

		function showGate() {
			main.classList.add("hidden");
			gate.classList.remove("hidden");
			list.replaceChildren(); // 上锁时清掉已解密的节点，不只是隐藏
			cats.replaceChildren();
			countEl.textContent = "";
			hintEl.textContent = "";
			input.value = "";
			dCv.replaceChildren();
			dTitle.textContent = "";
			dMeta.textContent = "";
			dTags.replaceChildren();
			dNote.replaceChildren();
			showList();
			sessionStorage.removeItem(CACHE_KEY);
		}

		form.addEventListener("submit", function (e) {
			e.preventDefault();
			var pwd = input.value.trim();
			if (!pwd) return;
			err.classList.add("hidden");
			decrypt(pwd)
				.then(function (data) {
					sessionStorage.setItem(CACHE_KEY, pwd);
					render(data);
				})
				.catch(function () {
					err.classList.remove("hidden");
				});
		});

		lockBtn.addEventListener("click", showGate);

		var cached = sessionStorage.getItem(CACHE_KEY);
		if (cached) {
			decrypt(cached)
				.then(render)
				.catch(function () {
					sessionStorage.removeItem(CACHE_KEY);
				});
		}
	})();
</script>
