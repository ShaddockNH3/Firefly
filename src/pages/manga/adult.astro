---
import MangaTabs from "@/components/pages/manga/MangaTabs.astro";
import { siteConfig } from "@/config";
import enc from "@/data/manga/adult.enc.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.manga) {
	return Astro.redirect("/404/");
}

// 这个文件里只有密文。明文由 scripts/export-manga.mjs 在本地生成后立刻加密，
// 全程不落盘、不进 git。未解锁时页面里既没有书名，也没有封面地址。
const payload = enc.data;
---

<MainGridLayout title="成人向" description="密码保护的漫画清单">
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<MangaTabs active="adult" />

		<div class="flex items-center gap-3 flex-wrap mb-4">
			<h2 class="text-lg font-bold text-(--deep-text) m-0">成人向</h2>
			<span class="ml-auto inline-flex items-center gap-1 text-[0.7rem] text-(--content-meta)">
				整页加密 · 密码解锁后显示
			</span>
		</div>

		<!-- 未解锁 -->
		<div id="manga-gate" class="mx-auto max-w-115 py-10 text-center">
			<div
				class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-(--primary)/10 text-(--primary)"
			>
				<svg
					viewBox="0 0 24 24"
					width="26"
					height="26"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="3" y="11" width="18" height="11" rx="2"></rect>
					<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
				</svg>
			</div>
			<h3 class="m-0 mb-2 text-base font-bold text-(--deep-text)">本页受密码保护</h3>
			<p class="m-0 mb-5 text-[0.78rem] leading-relaxed text-(--content-meta)">
				清单在构建时已加密，没有密码时页面里只有一段密文。<br />未满 18 岁请勿继续。
			</p>
			<form id="manga-form" class="flex flex-col gap-2">
				<input
					id="manga-pw"
					type="password"
					autocomplete="off"
					placeholder="输入密码"
					class="w-full rounded-lg border border-(--line-divider) bg-black/3 px-3 py-2 text-sm text-(--deep-text) outline-hidden transition focus:border-(--primary) dark:bg-white/8"
				/>
				<button
					type="submit"
					class="w-full rounded-lg bg-(--primary) py-2 text-sm font-semibold text-white transition hover:opacity-90 active:scale-[0.99]"
				>
					解锁
				</button>
			</form>
			<p id="manga-error" class="m-0 mt-3 hidden text-[0.72rem] text-red-500 dark:text-red-400">
				密码不对
			</p>
			<p class="m-0 mt-4 text-[0.7rem] text-(--content-meta) opacity-70">
				密码只存在本地 sessionStorage，关掉标签页就没了
			</p>
		</div>

		<!-- 已解锁 -->
		<div id="manga-main" class="hidden">
			<div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<b class="text-[0.84rem] text-(--deep-text)" id="manga-count"></b>
				<span class="text-[0.72rem] text-(--content-meta)" id="manga-hint"></span>
				<button
					id="manga-lock"
					class="ml-auto cursor-pointer border-0 bg-none p-0 text-[0.74rem] text-(--content-meta) hover:text-(--primary)"
				>
					上锁
				</button>
			</div>

			<!-- 分类：就是 Venera 里的收藏夹 -->
			<div id="manga-cats" class="mb-4 flex flex-wrap gap-1.5"></div>

			<div id="manga-list" class="manga-grid"></div>
		</div>
	</div>
</MainGridLayout>

<!-- 详情：解锁后才渲染内容，锁上时清空 -->
<dialog id="manga-detail" class="manga-dlg">
	<div class="manga-dlg-in">
		<div class="manga-dlg-cv" id="manga-dlg-cv"></div>
		<div class="manga-dlg-body">
			<div class="manga-dlg-head">
				<h3 id="manga-dlg-title"></h3>
				<button id="manga-dlg-close" aria-label="关闭">×</button>
			</div>
			<div class="manga-dlg-meta" id="manga-dlg-meta"></div>
			<div class="manga-dlg-note" id="manga-dlg-note"></div>
		</div>
	</div>
</dialog>

<style is:global>
	.manga-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
		gap: 18px 14px;
	}
	.manga-card {
		display: block;
		cursor: pointer;
		border: 0;
		background: none;
		padding: 0;
		text-align: left;
		font: inherit;
	}
	.manga-cv {
		position: relative;
		aspect-ratio: 3 / 4;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 20px 14px 16px;
		overflow: hidden;
		border: 1px solid hsl(var(--h) 30% 78% / 0.5);
		background: linear-gradient(
			162deg,
			hsl(var(--h) 48% 95%) 0%,
			hsl(var(--h) 46% 87%) 55%,
			hsl(var(--h) 42% 79%) 100%
		);
		transition:
			transform 0.18s,
			box-shadow 0.18s;
	}
	.manga-cv img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.manga-card:hover .manga-cv {
		transform: translateY(-2px);
		box-shadow: 0 10px 22px hsl(var(--h) 40% 40% / 0.16);
	}
	.manga-mid {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 0;
	}
	.manga-rule {
		width: 20px;
		height: 1px;
		background: hsl(var(--h) 34% 48% / 0.5);
		flex: none;
	}
	.manga-ttl {
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.6;
		letter-spacing: 0.08em;
		color: hsl(var(--h) 40% 24%);
		text-align: center;
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}
	.manga-foot {
		flex: none;
		font-size: 0.6rem;
		letter-spacing: 0.06em;
		color: hsl(var(--h) 26% 40% / 0.9);
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}
	.manga-sc {
		position: absolute;
		top: 6px;
		right: 6px;
		font-size: 0.64rem;
		font-weight: 800;
		padding: 1px 6px;
		border-radius: 6px;
		background: rgb(255 255 255 / 0.9);
		color: var(--primary);
	}
	.manga-nm {
		margin-top: 7px;
		font-size: 0.74rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--deep-text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* 分类 chip：样式跟站内筛选项一致 */
	.manga-chip {
		padding: 3px 11px;
		border-radius: 999px;
		border: 1px solid var(--line-divider);
		background: var(--card-bg);
		color: var(--content-meta);
		font-size: 0.72rem;
		font-family: inherit;
		cursor: pointer;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.manga-chip:hover {
		background: var(--btn-regular-bg);
	}
	.manga-chip[data-on="true"] {
		background: var(--primary);
		border-color: transparent;
		color: #fff;
	}
	.manga-chip em {
		font-style: normal;
		opacity: 0.65;
		margin-left: 3px;
	}

	/* 详情弹层 */
	.manga-dlg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 20px;
		border: none;
		background: rgb(0 0 0 / 0.7);
		display: none;
	}
	.manga-dlg[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.manga-dlg-in {
		display: flex;
		gap: 20px;
		max-width: 620px;
		width: 100%;
		max-height: 86vh;
		background: var(--card-bg);
		border-radius: 16px;
		padding: 18px;
		overflow: hidden;
	}
	.manga-dlg-cv {
		width: 200px;
		flex: none;
		aspect-ratio: 3 / 4;
		border-radius: 10px;
		overflow: hidden;
		background: var(--btn-regular-bg);
	}
	.manga-dlg-cv img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.manga-dlg-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		overflow-y: auto;
	}
	.manga-dlg-head {
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}
	.manga-dlg-head h3 {
		margin: 0;
		flex: 1;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.45;
		color: var(--deep-text);
		word-break: break-word;
	}
	.manga-dlg-head button {
		flex: none;
		border: 0;
		background: none;
		padding: 0 2px;
		font-size: 1.2rem;
		line-height: 1;
		color: var(--content-meta);
		cursor: pointer;
	}
	.manga-dlg-meta {
		margin-top: 8px;
		font-size: 0.74rem;
		color: var(--content-meta);
		line-height: 1.7;
	}
	.manga-dlg-note {
		margin-top: 12px;
		padding-top: 12px;
		border-top: 1px solid var(--line-divider);
		font-size: 0.8rem;
		line-height: 1.85;
		color: color-mix(in oklch, var(--deep-text) 82%, transparent);
		white-space: pre-line;
	}
	.manga-dlg-note:empty {
		display: none;
	}
	.manga-dlg-empty {
		color: var(--content-meta);
		font-size: 0.76rem;
	}
	@media (max-width: 640px) {
		.manga-dlg-in {
			flex-direction: column;
			gap: 14px;
		}
		.manga-dlg-cv {
			width: 130px;
		}
	}
</style>

<div id="manga-data" data-payload={payload} hidden></div>

<script is:inline>
	(function () {
		var ITERATIONS = 100000;
		var SALT_LEN = 16;
		var IV_LEN = 12;
		var TAG_LEN = 16;
		var CACHE_KEY = "pw:manga-adult";

		var payload = document.getElementById("manga-data").getAttribute("data-payload");

		var gate = document.getElementById("manga-gate");
		var main = document.getElementById("manga-main");
		var form = document.getElementById("manga-form");
		var input = document.getElementById("manga-pw");
		var err = document.getElementById("manga-error");
		var list = document.getElementById("manga-list");
		var cats = document.getElementById("manga-cats");
		var countEl = document.getElementById("manga-count");
		var hintEl = document.getElementById("manga-hint");
		var lockBtn = document.getElementById("manga-lock");

		var dlg = document.getElementById("manga-detail");
		var dlgCv = document.getElementById("manga-dlg-cv");
		var dlgTitle = document.getElementById("manga-dlg-title");
		var dlgMeta = document.getElementById("manga-dlg-meta");
		var dlgNote = document.getElementById("manga-dlg-note");
		document.getElementById("manga-dlg-close").addEventListener("click", function () {
			dlg.close();
		});
		dlg.addEventListener("click", function (e) {
			if (e.target === dlg) dlg.close();
		});

		function b64ToBytes(b64) {
			var bin = atob(b64);
			var out = new Uint8Array(bin.length);
			for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
			return out;
		}

		async function decrypt(pwd) {
			var raw = b64ToBytes(payload);
			var salt = raw.slice(0, SALT_LEN);
			var iv = raw.slice(SALT_LEN, SALT_LEN + IV_LEN);
			var tag = raw.slice(SALT_LEN + IV_LEN, SALT_LEN + IV_LEN + TAG_LEN);
			var ct = raw.slice(SALT_LEN + IV_LEN + TAG_LEN);
			var combined = new Uint8Array(ct.length + TAG_LEN);
			combined.set(ct);
			combined.set(tag, ct.length);

			var enc = new TextEncoder();
			var km = await crypto.subtle.importKey("raw", enc.encode(pwd), "PBKDF2", false, [
				"deriveKey",
			]);
			var key = await crypto.subtle.deriveKey(
				{ name: "PBKDF2", salt: salt, iterations: ITERATIONS, hash: "SHA-256" },
				km,
				{ name: "AES-GCM", length: 256 },
				false,
				["decrypt"],
			);
			var plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: iv }, key, combined);
			return JSON.parse(new TextDecoder().decode(plain));
		}

		var HUES = [348, 275, 200, 24, 158, 315, 232, 42, 300, 190];
		function hueOf(s) {
			var h = 0;
			for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 9973;
			return HUES[h % HUES.length];
		}

		var ALL = "全部";
		var state = { items: [], cat: ALL };

		function card(item) {
			var wrap = document.createElement("button");
			wrap.type = "button";
			wrap.className = "manga-card";
			wrap.title = item.t;
			wrap.addEventListener("click", function () {
				openDetail(item);
			});

			var cv = document.createElement("div");
			cv.className = "manga-cv";
			var hue = hueOf(item.t);
			cv.style.setProperty("--h", hue);

			if (item.c) {
				var img = document.createElement("img");
				img.loading = "lazy";
				img.referrerPolicy = "no-referrer";
				img.alt = "";
				img.src = item.c;
				// 图床挂了就退回排版封面，不留一个破图标
				img.addEventListener("error", function () {
					img.remove();
					buildFace(cv, item);
				});
				cv.appendChild(img);
			} else {
				buildFace(cv, item);
			}

			if (Number.isFinite(item.sc)) {
				var sc = document.createElement("span");
				sc.className = "manga-sc";
				sc.textContent = item.sc.toFixed(1);
				cv.appendChild(sc);
			}

			var nm = document.createElement("div");
			nm.className = "manga-nm";
			nm.textContent = item.t;

			wrap.append(cv, nm);
			return wrap;
		}

		// 没有封面时用书名排版占位
		function buildFace(cv, item) {
			var mid = document.createElement("div");
			mid.className = "manga-mid";
			var r1 = document.createElement("span");
			r1.className = "manga-rule";
			var ttl = document.createElement("span");
			ttl.className = "manga-ttl";
			ttl.textContent = item.t;
			var r2 = document.createElement("span");
			r2.className = "manga-rule";
			mid.append(r1, ttl, r2);

			var foot = document.createElement("span");
			foot.className = "manga-foot";
			foot.textContent = [item.s, item.y].filter(Boolean).join(" · ");

			cv.append(mid, foot);
		}

		function renderCats() {
			cats.replaceChildren();
			var counter = new Map();
			for (var i = 0; i < state.items.length; i++) {
				var f = state.items[i].f || "其他";
				counter.set(f, (counter.get(f) || 0) + 1);
			}
			var entries = [[ALL, state.items.length]].concat(
				[...counter.entries()].sort(function (a, b) {
					return b[1] - a[1];
				}),
			);

			entries.forEach(function (pair) {
				var b = document.createElement("button");
				b.type = "button";
				b.className = "manga-chip";
				b.dataset.on = String(state.cat === pair[0]);
				b.textContent = pair[0];
				var em = document.createElement("em");
				em.textContent = pair[1];
				b.appendChild(em);
				b.addEventListener("click", function () {
					state.cat = pair[0];
					renderCats();
					renderList();
				});
				cats.appendChild(b);
			});
		}

		function renderList() {
			list.replaceChildren();
			var frag = document.createDocumentFragment();
			var shown = 0;
			for (var i = 0; i < state.items.length; i++) {
				var it = state.items[i];
				if (state.cat !== ALL && (it.f || "其他") !== state.cat) continue;
				frag.append(card(it));
				shown += 1;
			}
			list.append(frag);
			countEl.textContent = state.cat === ALL ? "全部 " + shown + " 本" : state.cat + " " + shown + " 本";
			hintEl.textContent = "按 Venera 收藏夹分类";
		}

		function openDetail(item) {
			dlgCv.replaceChildren();
			if (item.c) {
				var img = document.createElement("img");
				img.src = item.c;
				img.referrerPolicy = "no-referrer";
				img.alt = "";
				dlgCv.appendChild(img);
			}
			dlgTitle.textContent = item.t;

			var bits = [item.s, item.f, item.y].filter(Boolean);
			if (Number.isFinite(item.sc)) bits.push("评分 " + item.sc.toFixed(1));
			dlgMeta.textContent = bits.join(" · ");

			dlgNote.replaceChildren();
			if (item.nt) {
				dlgNote.textContent = item.nt;
			} else {
				var e = document.createElement("span");
				e.className = "manga-dlg-empty";
				e.textContent = "还没写评价。";
				dlgNote.appendChild(e);
			}
			dlg.showModal();
		}

		function render(data) {
			state.items = data.items;
			state.cat = ALL;
			renderCats();
			renderList();
			gate.classList.add("hidden");
			main.classList.remove("hidden");
		}

		function showGate() {
			main.classList.add("hidden");
			gate.classList.remove("hidden");
			list.replaceChildren(); // 上锁时清掉已解密的节点，不只是隐藏
			cats.replaceChildren();
			countEl.textContent = "";
			hintEl.textContent = "";
			input.value = "";
			if (dlg.open) dlg.close();
			dlgCv.replaceChildren();
			dlgTitle.textContent = "";
			dlgMeta.textContent = "";
			dlgNote.replaceChildren();
			sessionStorage.removeItem(CACHE_KEY);
		}

		form.addEventListener("submit", function (e) {
			e.preventDefault();
			var pwd = input.value.trim();
			if (!pwd) return;
			err.classList.add("hidden");
			decrypt(pwd)
				.then(function (data) {
					sessionStorage.setItem(CACHE_KEY, pwd);
					render(data);
				})
				.catch(function () {
					err.classList.remove("hidden");
				});
		});

		lockBtn.addEventListener("click", showGate);

		var cached = sessionStorage.getItem(CACHE_KEY);
		if (cached) {
			decrypt(cached)
				.then(render)
				.catch(function () {
					sessionStorage.removeItem(CACHE_KEY);
				});
		}
	})();
</script>
