---
import MangaTabs from "@/components/pages/manga/MangaTabs.astro";
import { siteConfig } from "@/config";
import enc from "@/data/manga/adult.enc.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.manga) {
	return Astro.redirect("/404/");
}

// 这个文件里只有密文。明文由 scripts/export-manga.mjs 在本地生成后立刻加密，
// 全程不落盘、不进 git。
const payload = enc.data;
---

<MainGridLayout title="成人向" description="密码保护的漫画清单">
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<MangaTabs active="adult" />

		<div class="flex items-center gap-3 flex-wrap mb-4">
			<h2 class="text-lg font-bold text-(--deep-text) m-0">成人向</h2>
			<span class="ml-auto inline-flex items-center gap-1 text-[0.7rem] text-(--content-meta)">
				整页加密 · 密码解锁后显示
			</span>
		</div>

		<!-- 未解锁 -->
		<div id="manga-gate" class="mx-auto max-w-115 py-10 text-center">
			<div
				class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-(--primary)/10 text-(--primary)"
			>
				<svg
					viewBox="0 0 24 24"
					width="26"
					height="26"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="3" y="11" width="18" height="11" rx="2"></rect>
					<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
				</svg>
			</div>
			<h3 class="m-0 mb-2 text-base font-bold text-(--deep-text)">本页受密码保护</h3>
			<p class="m-0 mb-5 text-[0.78rem] leading-relaxed text-(--content-meta)">
				清单在构建时已加密，没有密码时页面里只有一段密文。<br />未满 18 岁请勿继续。
			</p>
			<form id="manga-form" class="flex flex-col gap-2">
				<input
					id="manga-pw"
					type="password"
					autocomplete="off"
					placeholder="输入密码"
					class="w-full rounded-lg border border-(--line-divider) bg-black/3 px-3 py-2 text-sm text-(--deep-text) outline-hidden transition focus:border-(--primary) dark:bg-white/8"
				/>
				<button
					type="submit"
					class="w-full rounded-lg bg-(--primary) py-2 text-sm font-semibold text-white transition hover:opacity-90 active:scale-[0.99]"
				>
					解锁
				</button>
			</form>
			<p id="manga-error" class="m-0 mt-3 hidden text-[0.72rem] text-red-500 dark:text-red-400">
				密码不对
			</p>
			<p class="m-0 mt-4 text-[0.7rem] text-(--content-meta) opacity-70">
				密码只存在本地 sessionStorage，关掉标签页就没了
			</p>
		</div>

		<!-- 已解锁 -->
		<div id="manga-main" class="hidden">
			<div class="mb-4 flex items-baseline gap-3">
				<b class="text-[0.84rem] text-(--deep-text)" id="manga-count"></b>
				<span class="text-[0.72rem] text-(--content-meta)">仅名称 · 不含封面</span>
				<button
					id="manga-lock"
					class="ml-auto cursor-pointer border-0 bg-none p-0 text-[0.74rem] text-(--content-meta) hover:text-(--primary)"
				>
					上锁
				</button>
			</div>
			<div id="manga-list" class="manga-grid"></div>
		</div>
	</div>
</MainGridLayout>

<style is:global>
	.manga-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
		gap: 18px 14px;
	}
	.manga-card {
		display: block;
	}
	.manga-cv {
		position: relative;
		aspect-ratio: 3 / 4;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 20px 14px 16px;
		overflow: hidden;
		border: 1px solid hsl(var(--h) 30% 78% / 0.5);
		background: linear-gradient(
			162deg,
			hsl(var(--h) 48% 95%) 0%,
			hsl(var(--h) 46% 87%) 55%,
			hsl(var(--h) 42% 79%) 100%
		);
		transition:
			transform 0.18s,
			box-shadow 0.18s;
	}
	.manga-card:hover .manga-cv {
		transform: translateY(-2px);
		box-shadow: 0 10px 22px hsl(var(--h) 40% 40% / 0.16);
	}
	.manga-mid {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 0;
	}
	.manga-rule {
		width: 20px;
		height: 1px;
		background: hsl(var(--h) 34% 48% / 0.5);
		flex: none;
	}
	.manga-ttl {
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.6;
		letter-spacing: 0.08em;
		color: hsl(var(--h) 40% 24%);
		text-align: center;
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}
	.manga-foot {
		flex: none;
		font-size: 0.6rem;
		letter-spacing: 0.06em;
		color: hsl(var(--h) 26% 40% / 0.9);
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}
</style>

<div id="manga-data" data-payload={payload} hidden></div>

<script is:inline>
	(function () {
		var ITERATIONS = 100000;
		var SALT_LEN = 16;
		var IV_LEN = 12;
		var TAG_LEN = 16;
		var CACHE_KEY = "pw:manga-adult";

		var payload = document.getElementById("manga-data").getAttribute("data-payload");

		var gate = document.getElementById("manga-gate");
		var main = document.getElementById("manga-main");
		var form = document.getElementById("manga-form");
		var input = document.getElementById("manga-pw");
		var err = document.getElementById("manga-error");
		var list = document.getElementById("manga-list");
		var countEl = document.getElementById("manga-count");
		var lockBtn = document.getElementById("manga-lock");

		function b64ToBytes(b64) {
			var bin = atob(b64);
			var out = new Uint8Array(bin.length);
			for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
			return out;
		}

		async function decrypt(pwd) {
			var raw = b64ToBytes(payload);
			var salt = raw.slice(0, SALT_LEN);
			var iv = raw.slice(SALT_LEN, SALT_LEN + IV_LEN);
			var tag = raw.slice(SALT_LEN + IV_LEN, SALT_LEN + IV_LEN + TAG_LEN);
			var ct = raw.slice(SALT_LEN + IV_LEN + TAG_LEN);
			var combined = new Uint8Array(ct.length + TAG_LEN);
			combined.set(ct);
			combined.set(tag, ct.length);

			var enc = new TextEncoder();
			var km = await crypto.subtle.importKey("raw", enc.encode(pwd), "PBKDF2", false, [
				"deriveKey",
			]);
			var key = await crypto.subtle.deriveKey(
				{ name: "PBKDF2", salt: salt, iterations: ITERATIONS, hash: "SHA-256" },
				km,
				{ name: "AES-GCM", length: 256 },
				false,
				["decrypt"],
			);
			var plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: iv }, key, combined);
			return JSON.parse(new TextDecoder().decode(plain));
		}

		var HUES = [348, 275, 200, 24, 158, 315, 232, 42, 300, 190];
		function hueOf(s) {
			var h = 0;
			for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 9973;
			return HUES[h % HUES.length];
		}

		function card(item) {
			var wrap = document.createElement("div");
			wrap.className = "manga-card";
			wrap.title = item.t;

			var cv = document.createElement("div");
			cv.className = "manga-cv";
			cv.style.setProperty("--h", hueOf(item.t));

			var mid = document.createElement("div");
			mid.className = "manga-mid";
			var r1 = document.createElement("span");
			r1.className = "manga-rule";
			var ttl = document.createElement("span");
			ttl.className = "manga-ttl";
			ttl.textContent = item.t; // 用 textContent，不拼 HTML
			var r2 = document.createElement("span");
			r2.className = "manga-rule";
			mid.append(r1, ttl, r2);

			var foot = document.createElement("span");
			foot.className = "manga-foot";
			foot.textContent = [item.s, item.y].filter(Boolean).join(" · ");

			cv.append(mid, foot);
			wrap.append(cv);
			return wrap;
		}

		function render(data) {
			list.replaceChildren();
			var frag = document.createDocumentFragment();
			for (var i = 0; i < data.items.length; i++) frag.append(card(data.items[i]));
			list.append(frag);
			countEl.textContent = "全部 " + data.items.length + " 本";
			gate.classList.add("hidden");
			main.classList.remove("hidden");
		}

		function showGate() {
			main.classList.add("hidden");
			gate.classList.remove("hidden");
			list.replaceChildren(); // 上锁时清掉已解密的节点，不只是隐藏
			countEl.textContent = "";
			input.value = "";
			sessionStorage.removeItem(CACHE_KEY);
		}

		form.addEventListener("submit", function (e) {
			e.preventDefault();
			var pwd = input.value.trim();
			if (!pwd) return;
			err.classList.add("hidden");
			decrypt(pwd)
				.then(function (data) {
					sessionStorage.setItem(CACHE_KEY, pwd);
					render(data);
				})
				.catch(function () {
					err.classList.remove("hidden");
				});
		});

		lockBtn.addEventListener("click", showGate);

		var cached = sessionStorage.getItem(CACHE_KEY);
		if (cached) {
			decrypt(cached)
				.then(render)
				.catch(function () {
					sessionStorage.removeItem(CACHE_KEY);
				});
		}
	})();
</script>
