---
import { getCollection } from "astro:content";
import MangaGrid from "@/components/pages/manga/MangaGrid.svelte";
import PageTabs from "@/components/pages/media/PageTabs.astro";
import { siteConfig } from "@/config";
import subjectsData from "@/data/manga/subjects.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/media-grid.css";

if (!siteConfig.pages.manga) {
	return Astro.redirect("/404/");
}

const subjects = subjectsData.items as Record<
	string,
	{
		cn: string;
		jp: string;
		cover: string;
		date: string;
		volumes: number;
		bgmScore: number | null;
		rank: number | null;
		tags: string[];
		summary: string;
	}
>;

const entries = (await getCollection("manga")).filter((e) => !e.data.draft);

const items = entries.map((e) => {
	const id = e.data.bgm || Number(e.id);
	const meta = subjects[String(id)];
	if (!meta) {
		throw new Error(
			`[manga] ${e.id} 缺少条目信息，先跑 pnpm fetch:bangumi:manga`,
		);
	}
	return {
		id,
		cn: meta.cn,
		jp: meta.jp,
		cover: meta.cover,
		date: meta.date,
		volumes: meta.volumes,
		bgmScore: meta.bgmScore,
		rank: meta.rank,
		tags: meta.tags,
		status: e.data.status,
		score: e.data.score,
		read: e.data.read,
		updated:
			[e.data.finished, e.data.started, e.data.updated]
				.filter(Boolean)
				.sort()
				.at(-1) ?? "",
	};
});

const reading = items.filter((i) => i.status === "在看").length;
---

<MainGridLayout title="漫画" description="漫画收藏与阅读记录">
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<PageTabs group="manga" active="general" />

		<div class="flex items-center gap-3 flex-wrap mb-4">
			<h2 class="text-lg font-bold text-(--deep-text) m-0">漫画</h2>
			{
				items.length > 0 && (
					<span class="text-[0.72rem] font-semibold px-2 py-0.5 rounded-full bg-(--btn-regular-bg) text-(--btn-content) tabular-nums">
						{items.length} 部
					</span>
				)
			}
			{reading > 0 && <span class="text-[0.72rem] text-(--content-meta)">在看 {reading}</span>}
		</div>

		{
			items.length > 0 ? (
				<MangaGrid client:load items={items} />
			) : (
				<p class="mg-empty">
					还没有收藏的漫画。在 src/content/manga/ 里加一条就会出现在这里。
				</p>
			)
		}
	</div>
</MainGridLayout>
