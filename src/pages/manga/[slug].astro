---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	if (!siteConfig.pages.manga) return [];
	const entries = await getCollection("manga");
	return entries
		.filter((e) => !e.data.draft && e.id !== "adult")
		.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const hasBody = (entry.body ?? "").trim().length > 0;
const { Content } = await render(entry);

const name = d.cn || d.title;
const alt = d.alt && d.alt !== name ? d.alt : "";
const rows = [
	{ k: "作者", v: d.author || "—" },
	{ k: "出版", v: d.publisher || "—" },
	{ k: "连载", v: d.released || "—" },
	{ k: "卷数", v: d.volumes ? `${d.volumes} 卷` : "—" },
	{ k: "读到", v: d.read || "—" },
	{ k: "读完", v: d.finished || "—" },
	{ k: "状态", v: d.status },
	{ k: "我的评分", v: d.score !== null ? `${d.score.toFixed(1)} / 10` : "" },
].filter((r) => r.v);
---

<MainGridLayout title={name} description={`${name} 的阅读记录与评价`}>
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<a href="/manga/" class="md-back">
			<Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
			漫画
		</a>

		<div class="md-wrap">
		<div class="md-head">
			<div class="md-cover">
				{d.cover ? (
					<img src={d.cover} alt={name} referrerpolicy="no-referrer" />
				) : (
					<span class="md-cover-t">{name}</span>
				)}
			</div>

			<div class="md-info">
				<h1 class="md-title">{name}</h1>
				{alt ? <p class="md-alt">{alt}</p> : null}

				<div class="md-rows">
					{rows.map((r) => (
						<div class="md-row">
							<span class="md-k">{r.k}</span>
							<span class="md-v" data-status={r.k === "状态" ? r.v : undefined}>{r.v}</span>
						</div>
					))}
				</div>
			</div>
		</div>
		</div>
	</div>

	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7 mt-4">
		<div class="md-sec-t">
			评价
			{d.score !== null && <span class="md-sec-n">{d.score.toFixed(1)}</span>}
		</div>
		{hasBody ? (
			<Markdown class="md-review"><Content /></Markdown>
		) : (
			<p class="md-empty">还没有写评价。</p>
		)}
	</div>
</MainGridLayout>

<style>
	.md-back {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 0.78rem;
		color: var(--content-meta);
		text-decoration: none;
		margin-bottom: 16px;
	}
	.md-back:hover {
		color: var(--primary);
	}
	.md-back :global(.icon),
	.md-back :global(svg) {
		transform: rotate(180deg);
	}

	/* 内容区在站内三栏布局下只有 200 出头，按视口判断会漏，改用容器查询 */
	.md-wrap {
		container-type: inline-size;
	}
	.md-head {
		display: flex;
		gap: 28px;
		align-items: flex-start;
	}
	.md-cover {
		width: 230px;
		flex-shrink: 0;
	}
	.md-cover img,
	.md-cover-t {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius-large);
		box-shadow: 0 4px 18px rgb(0 0 0 / 0.1);
		background: var(--btn-regular-bg);
	}
	.md-cover-t {
		padding: 18px 16px;
		text-align: center;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.7;
		color: var(--deep-text);
		background: linear-gradient(
			160deg,
			color-mix(in oklch, var(--primary) 7%, var(--card-bg)) 0%,
			color-mix(in oklch, var(--primary) 18%, var(--card-bg)) 100%
		);
		word-break: break-word;
	}
	.md-info {
		flex: 1;
		min-width: 0;
		padding-top: 4px;
	}
	.md-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--deep-text);
	}
	.md-alt {
		margin: 5px 0 0;
		font-size: 0.82rem;
		color: var(--content-meta);
	}
	.md-rows {
		margin-top: 18px;
		display: flex;
		flex-direction: column;
	}
	.md-row {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 8px 0;
		border-bottom: 1px solid var(--line-divider);
		font-size: 0.8rem;
	}
	.md-row:last-child {
		border-bottom: none;
	}
	.md-k {
		width: 72px;
		flex-shrink: 0;
		color: var(--content-meta);
	}
	.md-v {
		color: var(--deep-text);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.md-v[data-status="已读完"] {
		color: #108a64;
	}
	.md-v[data-status="在读"] {
		color: var(--primary);
	}

	.md-sec-t {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--deep-text);
		margin-bottom: 12px;
	}
	.md-sec-n {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 1px 8px;
		border-radius: 999px;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		font-variant-numeric: tabular-nums;
	}
	.md-review :global(.custom-md) {
		margin: 0;
	}
	.md-empty {
		margin: 0;
		padding: 22px 0;
		font-size: 0.82rem;
		color: var(--content-meta);
	}

	@container (max-width: 520px) {
		.md-head {
			flex-direction: column;
			gap: 18px;
		}
		.md-cover {
			width: 150px;
		}
	}
</style>
