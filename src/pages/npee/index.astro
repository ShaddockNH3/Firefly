---
import TopicIndex from "@/components/pages/topic/TopicIndex.astro";
import { siteConfig } from "@/config";
import { npeeSeries, npeeTrackOrder, npeeUngrouped } from "@/config/npee";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.npee) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title="考研 · 长线" description="408 与数学二的备考全过程">
	<TopicIndex
		series={npeeSeries}
		order={npeeTrackOrder}
		ungrouped={npeeUngrouped}
		heading="考研"
	/>
</MainGridLayout>
