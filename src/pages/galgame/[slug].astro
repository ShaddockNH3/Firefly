---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	if (!siteConfig.pages.galgame) return [];
	const entries = await getCollection("galgame");
	return entries
		.filter((e) => !e.data.draft)
		.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const hasBody = (entry.body ?? "").trim().length > 0;
const { Content } = await render(entry);

const name = d.cn || d.title;
const alt = d.alt && d.alt !== name ? d.alt : "";
const rows = [
	{ k: "会社", v: d.developer || "—" },
	{ k: "发售", v: d.released || "—" },
	// 通关 / 时长 固定占位，没填时显示破折号，一眼能看出还缺什么
	{ k: "通关", v: d.finished || "—" },
	{ k: "时长", v: d.hours ? `${d.hours} 小时` : "—" },
	{ k: "状态", v: d.status },
	{ k: "我的评分", v: d.score !== null ? `${d.score.toFixed(1)} / 10` : "" },
	{
		k: "VNDB 评分",
		v: d.vndbRating !== null ? `${(d.vndbRating / 10).toFixed(1)} / 10` : "",
	},
].filter((r) => r.v);
---

<MainGridLayout title={name} description={`${name} 的游玩记录与评价`}>
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<a href="/galgame/" class="gl-back">
			<Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
			galgame
		</a>

		<div class="gl-head">
			<div class="gl-cover">
				{d.cover ? <img src={d.cover} alt={name} referrerpolicy="no-referrer" /> : null}
			</div>

			<div class="gl-info">
				<h1 class="gl-title">{name}</h1>
				{alt ? <p class="gl-alt">{alt}</p> : null}

				<div class="gl-rows">
					{rows.map((r) => (
						<div class="gl-row">
							<span class="gl-k">{r.k}</span>
							<span class="gl-v" data-status={r.k === "状态" ? r.v : undefined}>{r.v}</span>
						</div>
					))}
				</div>

				{d.vndb ? (
					<a
						href={`https://vndb.org/${d.vndb}`}
						target="_blank"
						rel="noopener"
						class="gl-link"
					>
						VNDB 词条
						<Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.66rem]" />
					</a>
				) : null}
			</div>
		</div>
	</div>

	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7 mt-4">
		<div class="gl-sec-t">
			评价
			{d.score !== null && <span class="gl-sec-n">{d.score.toFixed(1)}</span>}
		</div>
		{hasBody ? (
			<Markdown class="gl-review"><Content /></Markdown>
		) : (
			<p class="gl-empty">还没有写评价。</p>
		)}
	</div>
</MainGridLayout>

<style>
	.gl-back {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 0.78rem;
		color: var(--content-meta);
		text-decoration: none;
		margin-bottom: 16px;
	}
	.gl-back:hover {
		color: var(--primary);
	}
	.gl-back :global(.icon),
	.gl-back :global(svg) {
		transform: rotate(180deg);
	}

	.gl-head {
		display: flex;
		gap: 28px;
		align-items: flex-start;
	}
	.gl-cover {
		width: 230px;
		flex-shrink: 0;
	}
	.gl-cover img {
		width: 100%;
		display: block;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius-large);
		box-shadow: 0 4px 18px rgb(0 0 0 / 0.1);
		background: var(--btn-regular-bg);
	}
	.gl-info {
		flex: 1;
		min-width: 0;
		padding-top: 4px;
	}
	.gl-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--deep-text);
	}
	.gl-alt {
		margin: 5px 0 0;
		font-size: 0.82rem;
		color: var(--content-meta);
	}
	.gl-rows {
		margin-top: 18px;
		display: flex;
		flex-direction: column;
	}
	.gl-row {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 8px 0;
		border-bottom: 1px solid var(--line-divider);
		font-size: 0.8rem;
	}
	.gl-row:last-child {
		border-bottom: none;
	}
	.gl-k {
		width: 72px;
		flex-shrink: 0;
		color: var(--content-meta);
	}
	.gl-v {
		color: var(--deep-text);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.gl-v[data-status="已通关"] {
		color: #108a64;
	}
	.gl-v[data-status="在玩"] {
		color: var(--primary);
	}
	.gl-link {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		margin-top: 16px;
		padding: 6px 14px;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 26%, transparent);
		text-decoration: none;
	}
	.gl-link:hover {
		background: color-mix(in oklch, var(--primary) 16%, transparent);
	}

	.gl-sec-t {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--deep-text);
		margin-bottom: 12px;
	}
	.gl-sec-n {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 1px 8px;
		border-radius: 999px;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		font-variant-numeric: tabular-nums;
	}
	.gl-review :global(.custom-md) {
		margin: 0;
	}
	.gl-empty {
		margin: 0;
		padding: 22px 0;
		font-size: 0.82rem;
		color: var(--content-meta);
	}

	@media (max-width: 640px) {
		.gl-head {
			flex-direction: column;
			gap: 18px;
		}
		.gl-cover {
			width: 150px;
		}
	}
</style>
