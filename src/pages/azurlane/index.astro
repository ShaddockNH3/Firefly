---
import { Icon } from "astro-icon/components";
import AlTabs from "@/components/pages/azurlane/AlTabs.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import profile from "@/data/azurlane/profile.json";
import shipsData from "@/data/azurlane/ships.json";
import skinsData from "@/data/azurlane/skins.json";
import { allSkins } from "@/utils/azurlane-skins";
import mine from "@/data/azurlane/mine.json";

if (!siteConfig.pages.azurlane) {
	return Astro.redirect("/404/");
}

const total = shipsData.length;
const skinsTotal = allSkins.length;
const l2d = skinsData.filter((k) => k.k === "L2D").length;

const kpis = [
	{ icon: "material-symbols:workspace-premium", label: "收藏率", value: `${profile.collection}`, unit: "%", hi: true },
	{ icon: "material-symbols:shield", label: "舰队实力", value: profile.fleetPower.toLocaleString("en-US"), unit: "" },
	{ icon: "material-symbols:insights", label: "舰队科技", value: profile.techPoints.toLocaleString("en-US"), unit: "" },
	{ icon: "material-symbols:favorite", label: "誓约", value: `${profile.oath}`, unit: "" },
	{ icon: "material-symbols:shopping-bag", label: "皮肤", value: `${mine.skins.length}`, unit: `/ ${skinsTotal.toLocaleString("en-US")}` },
];
---

<MainGridLayout title="碧蓝航线" description="凉柚NH3 的碧蓝航线档案">
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<AlTabs active="profile" />

		<!-- 档案头 -->
		<div class="flex items-center gap-4 sm:gap-6 flex-wrap">
			<div
				class="w-18 h-18 sm:w-20 sm:h-20 rounded-full shrink-0 flex items-center justify-center bg-(--btn-regular-bg) text-(--primary)"
			>
				<Icon name="material-symbols:sailing" class="text-[2rem]" />
			</div>
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-2 flex-wrap">
					<span class="text-xl font-bold text-(--deep-text)">{profile.name}</span>
					<span class="text-[0.7rem] font-semibold px-2 py-0.5 rounded-full bg-(--primary)/12 text-(--primary)">
						{profile.server}
					</span>
				</div>
				<div class="flex items-center gap-3 mt-1 text-[0.78rem] text-(--content-meta) flex-wrap">
					<span class="inline-flex items-center gap-1">
						<Icon name="material-symbols:calendar-month" class="text-[0.95rem] opacity-70" />
						{profile.joined} 入坑
					</span>
					<span class="inline-flex items-center gap-1">
						<Icon name="material-symbols:verified" class="text-[0.95rem] opacity-70" />
						安卓服
					</span>
				</div>
				<div class="flex items-center gap-2.5 mt-2">
					<div class="w-44 h-1.5 rounded-full bg-(--btn-regular-bg) overflow-hidden">
						<div
							class="h-full rounded-full bg-(--primary)"
							style={`width:${(profile.level / profile.levelMax) * 100}%`}
						></div>
					</div>
					<span class="text-[0.7rem] text-(--content-meta) tabular-nums">
						Lv.{profile.level} / {profile.levelMax}
					</span>
				</div>
			</div>
			<span class="text-[0.7rem] text-(--content-meta) inline-flex items-center gap-1 ml-auto">
				<Icon name="material-symbols:schedule" class="text-[0.9rem]" />
				更新于 {profile.updated}
			</span>
		</div>

		<!-- 指标 -->
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-5">
			{kpis.map((k) => (
				<div class="rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-3">
					<div class="flex items-center gap-1.5 text-[0.72rem] text-(--content-meta)">
						<Icon name={k.icon} class="text-[0.95rem] opacity-65" />
						{k.label}
					</div>
					<div class="mt-1 flex items-baseline gap-1">
						<span class:list={["text-[1.3rem] font-bold tabular-nums", k.hi ? "text-(--primary)" : "text-(--deep-text)"]}>
							{k.value}
						</span>
						{k.unit && <span class="text-[0.72rem] text-(--content-meta)">{k.unit}</span>}
					</div>
				</div>
			))}
		</div>

		<!-- 收录概况 -->
		<div class="mt-5 rounded-xl border border-(--line-divider) px-4 py-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.78rem] text-(--content-meta)">
			<span>舰船 <b class="text-(--deep-text) tabular-nums">{total.toLocaleString("en-US")}</b> 艘</span>
			<span>换装 <b class="text-(--deep-text) tabular-nums">{skinsTotal.toLocaleString("en-US")}</b> 套</span>
			<span>其中 L2D <b class="text-(--deep-text) tabular-nums">{l2d}</b> 套</span>
			<span class="ml-auto inline-flex items-center gap-1.5">
				<Icon name="material-symbols:check-circle" class="text-[0.95rem] opacity-70" />
				已记录 {mine.owned.length} 艘 · {mine.skins.length} 套换装
			</span>
		</div>
	</div>
</MainGridLayout>
