---
import { Icon } from "astro-icon/components";
import ShipView from "@/components/pages/azurlane/ShipView.svelte";
import PageTabs from "@/components/pages/media/PageTabs.astro";
import { siteConfig } from "@/config";
import detailData from "@/data/azurlane/detail.json";
import mine from "@/data/azurlane/mine.json";
import shipsData from "@/data/azurlane/ships.json";
import skinsData from "@/data/azurlane/skins.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.azurlane) {
	return Astro.redirect("/404/");
}

export function getStaticPaths() {
	return shipsData.map((ship) => ({
		params: { name: ship.n },
		props: { ship },
	}));
}

const { ship } = Astro.props;
type Detail = {
	art?: string;
	refit?: string;
	oath?: string;
	cp?: number;
	rt?: boolean;
};
const info = (detailData as Record<string, Detail>)[ship.n] ?? {};
const ownedSet = new Set(mine.skins as string[]);
const copy =
	(mine.copies as Record<string, { need?: number; have?: number }>)[ship.n] ??
	{};

const skins = skinsData
	.filter((k) => k.s === ship.n)
	.map((k) => ({ ...k, owned: ownedSet.has(k.n) }));

const isOwned = (mine.owned as string[]).includes(ship.n);
const isMaxed = ((mine.maxed as string[] | undefined) ?? []).includes(ship.n);
---

<MainGridLayout title={`${ship.n} · 碧蓝航线`} description={`${ship.n} 的档案、复制人与换装`}>
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<div class="mb-3 flex items-center justify-between gap-3">
			<a href="/azurlane/dex/" class="inline-flex items-center gap-1 text-[0.78rem] text-(--content-meta) no-underline hover:text-(--primary)">
				<Icon name="material-symbols:chevron-right-rounded" class="text-[0.95rem] rotate-180" />
				返回图鉴
			</a>
			<PageTabs group="azurlane" active="dex" />
		</div>

		<ShipView
			client:visible
			ship={ship}
			info={info}
			skins={skins}
			owned={isOwned}
			have={copy.have ?? (isOwned ? 1 : 0)}
			hasRecord={(mine.owned as string[]).length > 0 || (mine.skins as string[]).length > 0}
			maxed={isMaxed}
		/>
	</div>
</MainGridLayout>
