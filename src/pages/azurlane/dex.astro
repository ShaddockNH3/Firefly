---
import { Icon } from "astro-icon/components";
import DexGrid from "@/components/pages/azurlane/DexGrid.svelte";
import PageTabs from "@/components/pages/media/PageTabs.astro";
import { siteConfig } from "@/config";
import mine from "@/data/azurlane/mine.json";
import profile from "@/data/azurlane/profile.json";
import shipsData from "@/data/azurlane/ships.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.azurlane) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title="舰船图鉴" description="碧蓝航线舰船图鉴">
	<div class="card-base px-4 sm:px-6 md:px-9 py-5 sm:py-7">
		<PageTabs group="azurlane" active="dex" />

		<div class="flex items-center gap-3 flex-wrap mb-4">
			<h2 class="text-lg font-bold text-(--deep-text) m-0">舰船图鉴</h2>
			<span class="text-[0.72rem] font-semibold px-2 py-0.5 rounded-full bg-(--btn-regular-bg) text-(--btn-content) tabular-nums">
				{shipsData.length} 艘
			</span>
			<span class="ml-auto inline-flex items-center gap-1 text-[0.7rem] text-(--content-meta)">
				<Icon name="material-symbols:schedule" class="text-[0.9rem]" />
				更新于 {profile.updated}
			</span>
		</div>

		<DexGrid client:load ships={shipsData} owned={mine.owned} />
	</div>
</MainGridLayout>
