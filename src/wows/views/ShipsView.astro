---
interface Props {
	/** 视图挂在子路径时（博客里是 /wows）传进来 */
	basePath?: string;
}

import profile from "../data/profile.json";
import ships from "../data/ships.json";
import Select from "../components/Select.astro";
import { pct, num, relative, wrGrade, typeVar } from "../utils/format";


// PR 分档，沿用 wows-numbers 的区间
const prKey = (pr: number | null) => {
	if (pr == null) return "low";
	if (pr >= 2450) return "super";
	if (pr >= 2100) return "elite";
	if (pr >= 1750) return "great";
	if (pr >= 1550) return "good";
	if (pr >= 1350) return "above";
	if (pr >= 1100) return "average";
	if (pr >= 750) return "below";
	return "low";
};

// 独立部署时取 BASE_URL；嵌进博客时由外层传入
const { basePath } = Astro.props;
const base = basePath ?? import.meta.env.BASE_URL.replace(/\/$/, "");
const p = profile.pvp;

const types = [...new Set(ships.map((s) => s.type))].map((t) => ({
	key: t,
	label: ships.find((s) => s.type === t)?.typeLabel ?? t,
	color: typeVar(t),
}));
const tiers = [...new Set(ships.map((s) => s.tier))].sort((a, b) => a - b);
const nations = [...new Set(ships.map((s) => s.nation))].map((n) => ({
	key: n,
	label: ships.find((s) => s.nation === n)?.nationLabel ?? n,
	battles: ships.filter((s) => s.nation === n).reduce((a, b) => a + b.battles, 0),
}));
/** 国服接口没有逐船的战斗时间，该列整个隐藏 */
const hasLastBattle = ships.some((s) => s.lastBattleAt > 0);

const SORT_OPTIONS = [
	{ value: "pr:desc", label: "PR 最高" },
	{ value: "battles:desc", label: "场次最多" },
	{ value: "winrate:desc", label: "胜率最高" },
	{ value: "damage:desc", label: "场均伤害最高" },
	{ value: "frags:desc", label: "场均击杀最高" },
	{ value: "survival:desc", label: "生存率最高" },
	...(hasLastBattle ? [{ value: "last:desc", label: "最近出战" }] : []),
	{ value: "tier:desc", label: "等级最高" },
];
---

<div class="container">
		<header style="padding:3.2rem 0 1.6rem">
			<span class="hero-badge">{profile.realmLabel} · {profile.nickname}</span>
			<h1
				style="margin:.7rem 0 .3rem;font-size:clamp(1.9rem,4vw,2.6rem);font-weight:800;letter-spacing:-.02em"
			>
				舰船战绩
			</h1>
			<p class="hero-sub">
				<span>{ships.length} 艘出过海的船</span>
				<span class="dot-sep"></span>
				<span>{num(p.battles)} 场随机战</span>
				<span class="dot-sep"></span>
				<span>胜率 {pct(p.winrate)}</span>
			</p>
		</header>

		<div class="toolbar">
			<label class="search-box">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m16.2 16.2 4 4"></path>
				</svg>
				<input
					type="search"
					id="q"
					placeholder="搜索船名（中文 / English）"
					autocomplete="off"
					aria-label="搜索船名"
				/>
			</label>

			<Select
				id="tier"
				label="按等级筛选"
				options={[{ value: "", label: "全部等级" }, ...tiers.map((t) => ({ value: String(t), label: `Tier ${t}` }))]}
			/>

			<Select
				id="nation"
				label="按国籍筛选"
				options={[
					{ value: "", label: "全部国籍" },
					...nations.map((n) => ({ value: n.key, label: `${n.label} · ${n.battles} 场` })),
				]}
			/>

			<Select
				id="sort"
				label="排序方式"
				align="right"
				options={SORT_OPTIONS}
			/>
		</div>

		<div class="toolbar" style="margin-top:-.5rem">
			<div class="chips" id="types">
				<button class="chip" type="button" data-type="" aria-pressed="true">全部</button>
				{
					types.map((t) => (
						<button class="chip" type="button" data-type={t.key} aria-pressed="false">
							<span
								style={`display:inline-block;width:.45rem;height:.45rem;border-radius:2px;background:${t.color};margin-right:.35rem`}
							/>
							{t.label}
						</button>
					))
				}
			</div>
			<span class="result-count" id="count" style="margin-left:auto">
				{ships.length} 艘
			</span>
		</div>

		<div class="table-wrap">
			<table class="ships" id="table">
					<colgroup>
						<col style="width:24%" />
						<col style="width:9%" />
						<col style="width:8%" />
						<col style="width:11.5%" />
						<col style="width:11%" />
						<col style="width:9.5%" />
						<col style="width:9%" />
						<col style="width:9%" />
						{hasLastBattle && <col style="width:9%" />}
					</colgroup>
					<thead>
						<tr>
							<th>舰船</th>
							<th data-sort="pr" aria-sort="descending">PR</th>
							<th data-sort="battles">场次</th>
							<th data-sort="winrate">胜率</th>
							<th data-sort="damage">场均伤害</th>
							<th data-sort="frags">场均击杀</th>
							<th data-sort="survival">生存率</th>
							<th data-sort="xp">场均经验</th>
							{hasLastBattle && <th data-sort="last">最后出战</th>}
						</tr>
					</thead>
				<tbody>
					{
						ships.map((s) => (
							<tr
								id={`ship-${s.shipId}`}
								data-search={`${s.name} ${s.nameEn}`.toLowerCase()}
								data-type={s.type}
								data-nation={s.nation}
								data-pr={s.pr ?? 0}
								data-tier={s.tier}
								data-battles={s.battles}
								data-winrate={s.winrate}
								data-damage={s.avgDamage}
								data-frags={s.avgFrags}
								data-survival={s.survival}
								data-xp={s.avgXp}
								data-last={s.lastBattleAt}
							>
								<td class="ship-cell">
									<div class="ship-cell-inner">
										<span class="tier" data-tier={s.tier} style="margin-left:.1rem">
											{s.tier}
										</span>
										{s.image && <img src={s.image} alt="" loading="lazy" decoding="async" />}
										<span class="ship-cell-name">
											<b>{s.name}</b>
											<span>
												{s.typeLabel} · {s.nationLabel}
												{s.premium ? " · 金币" : ""}
											</span>
										</span>
									</div>
								</td>
								<td>
									{s.pr != null ? (
										<span class="score-cell" data-tier={prKey(s.pr)}>{s.pr}</span>
									) : (
										<span style="color:var(--wows-text-faint)">—</span>
									)}
								</td>
								<td>{num(s.battles)}</td>
								<td>
									<span class="wr" data-grade={wrGrade(s.winrate)}>
										<span class="wr-bar">
											<i style={`width:${Math.min(100, s.winrate * 100)}%`} />
										</span>
										<b>{pct(s.winrate)}</b>
									</span>
								</td>
								<td>{num(s.avgDamage)}</td>
								<td>{s.avgFrags.toFixed(2)}</td>
								<td>{pct(s.survival)}</td>
								<td>{num(s.avgXp)}</td>
								{hasLastBattle && <td style="color:var(--wows-text-faint)">{relative(s.lastBattleAt)}</td>}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<div class="empty" id="empty" hidden>
			<strong>没有符合条件的船</strong>
			换个关键词，或者把筛选清空试试
		</div>

		<p class="section-hint" style="margin-top:1.5rem">
			点击表头可切换排序。胜率颜色：绿 ≥52% · 青 52-58% · 黄 46-52% · 红 &lt;46%。
		</p>
	</div>

<script>
function initShipsPage() {
	const tableEl = document.getElementById("table");
	// swup 每次转场都会重跑，这里用标记防止重复绑定
	if (!tableEl || tableEl.dataset.wowsReady) return;
	tableEl.dataset.wowsReady = "1";

	const tbody = document.querySelector<HTMLElement>("#table tbody")!;
		const rows = [...tbody.querySelectorAll<HTMLTableRowElement>("tr")];
		const q = document.getElementById("q") as HTMLInputElement;
		const val = (id: string) => document.getElementById(id)?.dataset.value ?? "";
	const tierSel = document.getElementById("tier") as HTMLElement;
	const nationSel = document.getElementById("nation") as HTMLElement | null;
		const sortSel = document.getElementById("sort") as HTMLElement;
		const typeBox = document.getElementById("types")!;
		const count = document.getElementById("count")!;
		const empty = document.getElementById("empty")!;
		const table = document.getElementById("table")!;

		let activeType = "";
		let sortKey = "pr";
		let sortDir: 1 | -1 = -1;

		function apply() {
			const term = q.value.trim().toLowerCase();
			const tier = val("tier");
		const nation = val("nation");
			let shown = 0;

			for (const row of rows) {
				const ok =
					(!term || row.dataset.search!.includes(term)) &&
					(!activeType || row.dataset.type === activeType) &&
					(!tier || row.dataset.tier === tier) &&
					(!nation || row.dataset.nation === nation);
				row.hidden = !ok;
				if (ok) shown++;
			}

			count.textContent = `${shown} 艘`;
			table.parentElement!.hidden = shown === 0;
			empty.hidden = shown !== 0;
		}

		function sortBy(key: string, dir: 1 | -1) {
			const sorted = [...rows].sort((a, b) => {
				const av = Number(a.dataset[key] ?? 0);
				const bv = Number(b.dataset[key] ?? 0);
				return (av - bv) * dir;
			});
			for (const row of sorted) tbody.appendChild(row);
		}

		// 初始顺序由数据抓取时的顺序决定，这里按「PR 最高」重排一次，跟下拉默认项对齐
		sortBy(sortKey, sortDir);

		// 自定义下拉：原生 select 的展开列表由系统绘制，样式改不动，所以自己做一个
	const selects = [...document.querySelectorAll<HTMLElement>(".w-select")];
	const closeAll = () => {
		for (const el of selects) {
			el.classList.remove("is-open");
			el.querySelector(".w-select-btn")?.setAttribute("aria-expanded", "false");
		}
	};
	for (const el of selects) {
		const btn = el.querySelector<HTMLButtonElement>(".w-select-btn");
		const menu = el.querySelector<HTMLElement>(".w-select-menu");
		if (!btn || !menu) continue;

		btn.addEventListener("click", (e) => {
			e.stopPropagation();
			const wasOpen = el.classList.contains("is-open");
			closeAll();
			if (!wasOpen) {
				el.classList.add("is-open");
				btn.setAttribute("aria-expanded", "true");
			}
		});

		menu.addEventListener("click", (e) => {
			const opt = (e.target as HTMLElement).closest<HTMLElement>(".w-select-option");
			if (!opt) return;
			el.dataset.value = opt.dataset.value ?? "";
			const label = el.querySelector(".w-select-label");
			if (label) label.textContent = (opt.textContent ?? "").trim();
			for (const o of menu.querySelectorAll(".w-select-option")) {
				o.classList.toggle("is-selected", o === opt);
				o.setAttribute("aria-selected", String(o === opt));
			}
			closeAll();
			el.dispatchEvent(new CustomEvent("select-change", { bubbles: true }));
		});

		btn.addEventListener("keydown", (e) => {
			if (e.key === "Escape") closeAll();
		});
	}

	document.addEventListener("click", closeAll);

	// 方便截图/调试：?open=1 时展开第一个下拉
	if (new URLSearchParams(location.search).get("open")) {
		setTimeout(() => selects[0]?.querySelector<HTMLButtonElement>(".w-select-btn")?.click(), 200);
	}

	q.addEventListener("input", apply);
		tierSel.addEventListener("select-change", apply);
	nationSel?.addEventListener("select-change", apply);

		typeBox.addEventListener("click", (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".chip");
			if (!btn) return;
			for (const chip of typeBox.querySelectorAll<HTMLButtonElement>(".chip")) {
				chip.setAttribute("aria-pressed", String(chip === btn));
			}
			activeType = btn.dataset.type ?? "";
			apply();
		});

		sortSel.addEventListener("select-change", () => {
			const [key, dir] = (val("sort") || "battles:desc").split(":");
			sortKey = key;
			sortDir = dir === "asc" ? 1 : -1;
			sortBy(sortKey, sortDir);
		});

		for (const th of table.querySelectorAll<HTMLTableCellElement>("th[data-sort]")) {
			th.addEventListener("click", () => {
				const key = th.dataset.sort!;
				sortDir = sortKey === key ? ((sortDir * -1) as 1 | -1) : -1;
				sortKey = key;
				for (const other of table.querySelectorAll("th[data-sort]")) {
					other.removeAttribute("aria-sort");
				}
				th.setAttribute("aria-sort", sortDir === -1 ? "descending" : "ascending");
				sortBy(key, sortDir);
			});
		}

		// 支持 ?q=关键词&type=Battleship 直接带筛选进来，方便分享
		const params = new URLSearchParams(location.search);
		const initQ = params.get("q");
		const initType = params.get("type");
		if (initQ) q.value = initQ;
		if (initType) {
			const chip = typeBox.querySelector<HTMLButtonElement>(`[data-type="${CSS.escape(initType)}"]`);
			if (chip) {
				for (const c of typeBox.querySelectorAll<HTMLButtonElement>(".chip")) {
					c.setAttribute("aria-pressed", String(c === chip));
				}
				activeType = initType;
			}
		}
		if (initQ || initType) apply();

		// 从首页带 #ship-xxx 跳进来时，直接定位那艘船
		if (location.hash.startsWith("#ship-")) {
			const target = document.querySelector(location.hash);
			if (target) {
				target.scrollIntoView({ block: "center", behavior: "smooth" });
				target.animate(
					[
						{ background: "var(--wows-primary-soft)" },
						{ background: "transparent" },
					],
					{ duration: 1800, easing: "ease-out" },
				);
			}
		}
}

document.addEventListener("astro:page-load", initShipsPage);
initShipsPage();
</script>
