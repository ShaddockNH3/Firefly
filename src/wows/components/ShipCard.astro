---
import { typeVar, num, compact, pct } from "../utils/format";

interface Ship {
	shipId: number;
	name: string;
	nameEn: string;
	tier: number;
	type: string;
	typeLabel: string;
	nationLabel: string;
	premium: boolean;
	image: string | null;
	battles: number;
	winrate: number;
	avgDamage: number;
}

interface Props {
	ship: Ship;
	href?: string;
}

const { ship, href = "#" } = Astro.props;
const ROMAN = ["", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI"];
---

<a class="card card-hover ship-card" href={href} id={`ship-${ship.shipId}`}>
	<div class="ship-thumb">
		{
			ship.image ? (
				<img src={ship.image} alt={ship.name} loading="lazy" decoding="async" />
			) : (
				<span style="color:var(--wows-text-faint);font-size:.8rem">{ship.nameEn}</span>
			)
		}
	</div>
	<div class="ship-body">
		<div class="ship-title-row">
			<span class="tier" data-tier={ship.tier}>{ROMAN[ship.tier] ?? ship.tier}</span>
			<span class="ship-name">{ship.name}</span>
			<span class="ship-name-en">{ship.nameEn}</span>
		</div>
		<div class="ship-tags">
			<span class="tag tag-type" style={`--tag-color:${typeVar(ship.type)}`}>{ship.typeLabel}</span>
			<span class="tag">{ship.nationLabel}</span>
			{ship.premium && <span class="tag">金币</span>}
		</div>
		<div class="ship-stats">
			<div class="ship-stat">
				<b>{num(ship.battles)}</b>
				<span>场次</span>
			</div>
			<div class="ship-stat">
				<b>{pct(ship.winrate)}</b>
				<span>胜率</span>
			</div>
			<div class="ship-stat">
				<b>{compact(ship.avgDamage)}</b>
				<span>场均</span>
			</div>
		</div>
	</div>
</a>
