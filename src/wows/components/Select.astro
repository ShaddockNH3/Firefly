---
interface Option {
	value: string;
	label: string;
}

interface Props {
	id: string;
	options: Option[];
	value?: string;
	/** 无障碍标签 */
	label: string;
	/** 菜单靠哪边对齐 */
	align?: "left" | "right";
}

const { id, options, value = "", label, align = "left" } = Astro.props;
const current = options.find((o) => o.value === value) ?? options[0];
---

<div class="w-select" id={id} data-value={value} data-align={align}>
	<button
		type="button"
		class="w-select-btn"
		aria-haspopup="listbox"
		aria-expanded="false"
		aria-label={label}
	>
		<span class="w-select-label">{current.label}</span>
		<svg
			class="w-select-chevron"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="m6 9 6 6 6-6"></path>
		</svg>
	</button>

	<ul class="w-select-menu" role="listbox" aria-label={label}>
		{
			options.map((o) => (
				<li
					class:list={["w-select-option", { "is-selected": o.value === value }]}
					role="option"
					data-value={o.value}
					aria-selected={o.value === value}
					tabindex="-1"
				>
					{o.label}
				</li>
			))
		}
	</ul>
</div>
