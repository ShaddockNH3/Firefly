---
import { siteConfig } from "../config";
import meta from "../data/meta.json";

const generated = new Date(meta.generatedAt).toLocaleDateString("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
---

<footer class="footer">
	<div class="container footer-inner">
		<div>
			© {new Date().getFullYear()} {siteConfig.author} · 数据来自 Wargaming / 360 公开 API
		</div>
		<div>
			数据更新于 {generated}
			{meta.gameVersion && ` · 客户端 ${meta.gameVersion}`} · 本站与 Wargaming、360 无关联
		</div>
	</div>
</footer>
