---
import { siteConfig } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const basePath = base ? path.replace(base, "") || "/" : path;

const links = [
	{ href: `${base}/`, label: "总览", match: "/" },
	{ href: `${base}/ships`, label: "舰船", match: "/ships" },
];
---

<header class="nav">
	<div class="container nav-inner">
		<a class="brand" href={`${base}/`}>
			<span class="brand-mark">WS</span>
			<span class="brand-text">
				{siteConfig.title}
				<small>WOWS PROFILE</small>
			</span>
		</a>

		<nav class="nav-links" aria-label="主导航">
			{
				links.map((l) => (
					<a
						class="nav-link"
						href={l.href}
						aria-current={basePath === l.match ? "page" : undefined}
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="nav-right">
			{
				siteConfig.blogUrl && (
					<a class="nav-link" href={siteConfig.blogUrl} rel="noopener">
						博客
					</a>
				)
			}
			<button
				class="icon-btn icon-btn-dot"
				id="palette-toggle"
				type="button"
				data-palette={siteConfig.defaultTheme}
				aria-label="切换配色主题"
				title="切换配色：博客 / 海军"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
					<path d="M12 3.2a8.8 8.8 0 1 0 0 17.6c1.15 0 1.75-.83 1.75-1.78 0-1.02-.72-1.7-.72-2.55 0-.9.72-1.55 1.63-1.55h1.5a4.9 4.9 0 0 0 4.9-4.9c0-3.98-4.05-6.82-9.06-6.82Z"></path>
					<circle cx="7.6" cy="11.7" r="1.05" fill="currentColor" stroke="none"></circle>
					<circle cx="10.4" cy="7.8" r="1.05" fill="currentColor" stroke="none"></circle>
					<circle cx="14.8" cy="8.2" r="1.05" fill="currentColor" stroke="none"></circle>
				</svg>
			</button>
			<button class="icon-btn" id="theme-toggle" type="button" aria-label="切换深浅色">
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
					<circle cx="12" cy="12" r="4.2"></circle>
					<path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"></path>
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
					<path d="M20.4 14.6A8.6 8.6 0 1 1 9.4 3.6a7 7 0 0 0 11 11Z"></path>
				</svg>
			</button>
		</div>
	</div>
</header>
