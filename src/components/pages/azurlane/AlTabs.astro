---
interface Props {
	active: "profile" | "dex" | "skins";
}

const { active } = Astro.props;

const tabs = [
	{ key: "profile", label: "档案", href: "/azurlane/" },
	{ key: "dex", label: "图鉴", href: "/azurlane/dex/" },
	{ key: "skins", label: "换装", href: "/azurlane/skins/" },
] as const;
---

<nav class="al-tabs">
	{tabs.map((t) => (
		<a
			href={t.href}
			class="al-tab"
			data-on={active === t.key}
			aria-current={active === t.key ? "page" : undefined}
		>
			{t.label}
		</a>
	))}
</nav>

<style>
	.al-tabs {
		display: flex;
		gap: 6px;
		margin-bottom: 16px;
	}
	.al-tab {
		padding: 6px 16px;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--content-meta);
		background: var(--card-bg);
		border: 1px solid var(--line-divider);
		text-decoration: none;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.al-tab:hover {
		background: var(--btn-regular-bg);
	}
	.al-tab[data-on="true"] {
		background: var(--primary);
		border-color: transparent;
		color: #fff;
	}
</style>
