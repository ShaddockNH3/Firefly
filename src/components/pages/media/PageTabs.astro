---
import { type PageTab, type PageTabGroup, pageTabs } from "@/config/pageTabs";
import "@/styles/pages/media-shared.css";

interface Props {
	/** 用注册表里的固定分组（漫画 / 碧蓝） */
	group?: PageTabGroup;
	/** 或者直接给一份 tab 列表（单机游戏按配置里的游戏生成） */
	tabs?: PageTab[];
	active: string;
}

const { group, tabs: explicit, active } = Astro.props;
const tabs: PageTab[] = explicit ?? (group ? pageTabs[group] : []);
---

<nav class="mg-tabs">
	{
		tabs.map((t) => (
			<a
				href={t.href}
				class="mg-tab"
				data-on={active === t.key}
				aria-current={active === t.key ? "page" : undefined}
			>
				{t.label}
				{t.badge && <span class="mg-tab-18">{t.badge}</span>}
			</a>
		))
	}
</nav>
