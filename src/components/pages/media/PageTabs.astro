---
import { type PageTab, type PageTabGroup, pageTabs } from "@/config/pageTabs";
import "@/styles/pages/media-grid.css";

interface Props {
	group: PageTabGroup;
	active: string;
}

const { group, active } = Astro.props;
const tabs: PageTab[] = pageTabs[group];
---

<nav class="mg-tabs">
	{
		tabs.map((t) => (
			<a
				href={t.href}
				class="mg-tab"
				data-on={active === t.key}
				aria-current={active === t.key ? "page" : undefined}
			>
				{t.label}
				{t.badge && <span class="mg-tab-18">{t.badge}</span>}
			</a>
		))
	}
</nav>
